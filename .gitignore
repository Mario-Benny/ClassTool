# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Build output
build/
dist/
release/
download/
*.spec
*.exe
*.dll
*.pyd
*.zip
*.7z
*.rar

# Keep only finalized top-level release assets in Git.
!release/
release/*
!release/*.exe
!release/*.zip
!release/*.sha256
!release/update.json

# Runtime data
src/ClassTool/data/*
!src/ClassTool/data/.gitkeep
*.log
logs/

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
